# Copy to .env. Do not commit .env. Empty LLM_API_KEY is a configuration error.

# OpenAI-compatible endpoint. Client appends /chat/completions and /embeddings.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# RAG. CHUNK_OVERLAP must be >= 0 and < CHUNK_SIZE. Index dir is not created by the loader.
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_INDEX_DIR=./var/index

# Sandbox. BACKEND is docker | subprocess. Network default is off.
SANDBOX_BACKEND=subprocess
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_S=5
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_LIMIT=0.5
SANDBOX_NETWORK_ENABLED=false
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_WORKDIR=./var/sandbox

# Export. Missing parent directories are created by the exporter, not by the loader.
EXPORT_OUTPUT_DIR=./var/export
EXPORT_PDF_FONT=Helvetica
EXPORT_DOCX_FONT=Calibri

# DEBUG | INFO | WARNING | ERROR. Case-insensitive.
LOG_LEVEL=INFO
